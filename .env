# =============================================================================
# JAMBONZ WEBAPP ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all available environment variables for the jambonz webapp.
# Uncomment and modify values as needed for your deployment.

# =============================================================================
# CORE API CONFIGURATION
# =============================================================================

# API Base URL - Backend API endpoint
#VITE_API_BASE_URL=http://127.0.0.1:3000/v1

# Base URL for the webapp frontend
#VITE_APP_BASE_URL="http://jambonz.one"

# Development Base URL (used for local development)
#VITE_DEV_BASE_URL=http://127.0.0.1:3000/v1

# =============================================================================
# FEATURE FLAGS & UI OPTIONS
# =============================================================================

# Enable forgot password functionality on login screen
#VITE_APP_ENABLE_FORGOT_PASSWORD=true

# Enable hosted/cloud system features (billing, usage, etc.)
# VITE_APP_ENABLE_HOSTED_SYSTEM=true

# Disable LCR (Least Cost Routing) features in UI
#VITE_APP_LCR_DISABLED=true

# Disable Jaeger tracing UI features
#VITE_APP_JAEGER_TRACING_DISABLED=true

# Disable call recording features in UI
#VITE_APP_DISABLE_CALL_RECORDING=true

# Disable custom speech vendor configuration
# VITE_DISABLE_CUSTOM_SPEECH=false

# Disable additional speech vendors (limit to basic vendors only)
# VITE_APP_DISABLE_ADDITIONAL_SPEECH_VENDORS=true

# Disable default trunk routing features
#VITE_APP_DISABLE_DEFAULT_TRUNK_ROUTING=true

# Enable lazy loading for phone numbers (improves performance with large datasets)
# VITE_APP_ENABLE_PHONE_NUMBER_LAZY_LOAD=true

# Hide controls to add Carrier and Phone Number from non Admin/SP users
# Also requires the matching API-side flag to block direct API calls.
#VITE_ADMIN_CARRIER=1

# Controls alert polling interval time in seconds; set to 0 to disable polling.
#VITE_APP_ALERT_POLL_INTERVAL=60

# =============================================================================
# OAUTH & AUTHENTICATION
# =============================================================================

# GitHub OAuth Client ID for social login
#VITE_APP_GITHUB_CLIENT_ID=

# Google OAuth Client ID for social login
#VITE_APP_GOOGLE_CLIENT_ID=

# =============================================================================
# CLOUD & BILLING INTEGRATION
# =============================================================================

# AWS Region for cloud services
#VITE_APP_AWS_REGION=us-west-2

# Stripe Publishable Key for billing integration
#VITE_APP_STRIPE_PUBLISHABLE_KEY="pk_test_EChRaX9Tjk8csZZVSeoGqNvu00lsJzjaU1"

# Default Service Provider SID for single-tenant deployments
#VITE_APP_DEFAULT_SERVICE_PROVIDER_SID=

# =============================================================================
# RUNTIME ENVIRONMENT VARIABLES
# =============================================================================
# Note: These variables are also available as runtime environment variables
# that can be set in PM2/Docker without rebuilding the frontend:
#
# Runtime equivalents (set in ecosystem.config.js or Docker):
# - API_BASE_URL (maps to VITE_API_BASE_URL)
# - BASE_URL (maps to VITE_APP_BASE_URL)
# - ENABLE_FORGOT_PASSWORD (maps to VITE_APP_ENABLE_FORGOT_PASSWORD)
# - ENABLE_HOSTED_SYSTEM (maps to VITE_APP_ENABLE_HOSTED_SYSTEM)
# - DISABLE_LCR (maps to VITE_APP_LCR_DISABLED)
# - DISABLE_JAEGER_TRACING (maps to VITE_APP_JAEGER_TRACING_DISABLED)
# - DISABLE_CALL_RECORDING (maps to VITE_APP_DISABLE_CALL_RECORDING)
# - DISABLE_CUSTOM_SPEECH (maps to VITE_DISABLE_CUSTOM_SPEECH)
# - DISABLE_ADDITIONAL_SPEECH_VENDORS (maps to VITE_APP_DISABLE_ADDITIONAL_SPEECH_VENDORS)
# - AWS_REGION (maps to VITE_APP_AWS_REGION)
# - GITHUB_CLIENT_ID (maps to VITE_APP_GITHUB_CLIENT_ID)
# - GOOGLE_CLIENT_ID (maps to VITE_APP_GOOGLE_CLIENT_ID)
# - STRIPE_PUBLISHABLE_KEY (maps to VITE_APP_STRIPE_PUBLISHABLE_KEY)
# - DEFAULT_SERVICE_PROVIDER_SID (maps to VITE_APP_DEFAULT_SERVICE_PROVIDER_SID)
# - ENABLE_PHONE_NUMBER_LAZY_LOAD (maps to VITE_APP_ENABLE_PHONE_NUMBER_LAZY_LOAD)

# enables choosing units and licensed account call limits
#VITE_APP_ENABLE_ACCOUNT_LIMITS_ALL=true
